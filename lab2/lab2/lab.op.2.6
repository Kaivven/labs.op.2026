'use strict'

const average = (a, b) => (a + b) / 2;

const square = (x) => x * x;

const cube = (y) => y * y * y;

const calculate = () => {
    const result = [];
    for (let i = 0; i < 10; i++) {
        const action = average(square(i), cube(i));
        result.push(action);
    }
    return result;
}
console.log(calculate());